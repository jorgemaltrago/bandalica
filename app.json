{
  "expo": {
    "name": "Bandalica",
    "slug": "appbandalica",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/logo2.png",
    "scheme": "bandalica",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/assets/logo2.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./src/assets/logo2.png",
        "monochromeImage": "./src/assets/logo2.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jorgemartincabello.appbandalica"
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./src/assets/logo2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./src/assets/logo2.png",
          "imageWidth": 200
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "baseUrl": "/Bandalica",
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "026faa8b-d15c-4d7c-98b3-5dd90b08c0da"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    }
  }
}
